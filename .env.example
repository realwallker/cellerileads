# ==============================================================================
# CÉLLERI LEADS CRM — CONFIGURACIÓN DE ENTORNO
# Copia este archivo a .env.local para desarrollo local
# Agrega estas variables en el panel de Vercel (Project Settings > Environment Variables)
# ==============================================================================

# 1. META CONVERSIONS API (CAPI) & ADS INTEGRATION
# Dataset ID proporcionado para la campaña de Olonesa Reserva Village
META_DATASET_ID=3352860518219838
# Token de usuario del sistema generado en Meta Business Manager con permisos:
# ads_management, leads_retrieval y acceso asignado al Dataset
META_ACCESS_TOKEN=EAAG...
# Versión de la Graph API de Meta
META_API_VERSION=v21.0
# Código de prueba opcional obtenido en Events Manager > Pestaña 'Probar Eventos'
META_TEST_EVENT_CODE=
# Token secreto para validar el Webhook en Meta Developers (crea uno aleatorio)
META_WEBHOOK_VERIFY_TOKEN=celleri_secret_token_2026

# 2. TELEGRAM BOT NOTIFICATIONS
# Token obtenido al crear un bot con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=
# ID del grupo o chat privado de Telegram donde se envían las alertas (puedes obtenerlo con @userinfobot)
TELEGRAM_CHAT_ID=

# 3. SUPABASE (POSTGRESQL & AUTH)
# URL de tu proyecto en Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Llave anónima pública de Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...
# Llave Service Role secreta (solo para backend / webhooks)
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# 4. TIKTOK EVENTS API (FASE 2)
TIKTOK_ACCESS_TOKEN=
TIKTOK_PIXEL_CODE=
